generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIAgentConfig {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  isActive        Boolean   @default(false)
  systemPrompt    String    @default("You are a helpful customer support agent for Ricoz.")
  businessContext String?
  faq             String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Workspace {
  id                   String         @id @default(uuid())
  name                 String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  // Billing Fields
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  subscriptionStatus   String         @default("trialing") // trialing, active, past_due, canceled
  planTier             String         @default("Free Trial") // Starter, Growth, Advanced
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  users                User[]
  contacts             Contact[]
  tags                 Tag[]
  aiAgentConfig        AIAgentConfig?
  products             Product[]
  orders               Order[]
  slaConfig            SLAConfig?
  teamInvitations      TeamInvitation[]
  callLogs             CallLog[]
  ivrConfig            IVRConfig?
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?   // Hashed password
  name        String
  role        String    @default("Agent") // Owner, Admin, Agent, Viewer
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contact {
  id            String         @id @default(uuid())
  phoneNumber   String
  name          String?
  attributes    String?        @default("{}") // Storing JSON as string for SQLite
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  tags          Tag[]          @relation("ContactTags")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, phoneNumber])
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  color       String    @default("#00a688")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contacts    Contact[] @relation("ContactTags")
  createdAt   DateTime  @default(now())
}

model Conversation {
  id          String    @id @default(uuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id])
  status      String    @default("open") // open, resolved, snoozed
  channel     String    @default("whatsapp")
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  text           String
  sender         String       // "agent", "contact", "bot"
  status         String       @default("sent") // sent, delivered, read, failed
  timestamp      DateTime     @default(now())
}

model AutoReplyRule {
  id        String   @id @default(uuid())
  keyword   String   @unique
  replyText String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  name        String
  price       Float
  stock       Int       @default(0)
  status      String    @default("Active") // Active, Out of Stock, Draft
  image       String?   @default("bg-brand-primary")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id          String    @id @default(uuid())
  orderNumber String    @unique
  amount      Float
  status      String    @default("Pending") // Pending, Paid, Cancelled
  contactId   String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model SLAConfig {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  firstResponseTarget String    @default("Within 15 minutes")
  resolutionTarget    String    @default("Within 2 hours")
  workingHours        String    @default("Monday - Friday, 9:00 AM - 6:00 PM")
  updatedAt           DateTime  @updatedAt
}

model TeamInvitation {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("Agent")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  token       String    @unique @default(uuid())
  status      String    @default("Pending") // Pending, Accepted, Expired
  createdAt   DateTime  @default(now())
}

model CallLog {
  id          String    @id @default(uuid())
  contactName String
  phoneNumber String
  duration    String
  sentiment   String    @default("Neutral") // Positive, Neutral, Negative
  type        String    @default("incoming") // incoming, outgoing, missed
  transcript  String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  timestamp   DateTime  @default(now())
}

model IVRConfig {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  welcomeMessage String    @default("Thank you for calling Ricoz. How may we assist you today?")
  aiPrompt       String    @default("You are a friendly AI receptionist for Ricoz. Answer common inquiries and transfer to support if requested.")
  voiceGender    String    @default("female")
  fallbackNumber String?
  updatedAt      DateTime  @updatedAt
}

