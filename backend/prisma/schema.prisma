generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIAgentConfig {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  isActive            Boolean   @default(false)
  systemPrompt        String    @default("You are a helpful customer support agent for Ricoz.")
  businessContext     String?
  faq                 String?
  tone                String    @default("Professional") // Professional, Friendly, Empathetic, Direct, Persuasive
  responseLength      String    @default("concise") // concise, detailed
  humanHandoff        Boolean   @default(true)
  handoffKeywords     String?   @default("human,manager,agent,representative,support,person")
  confidenceThreshold Float     @default(0.65)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model KnowledgeDocument {
  id          String    @id @default(uuid())
  title       String
  sourceType  String    @default("file") // file, url, text, faq
  fileType    String?   @default("txt")  // pdf, docx, txt, csv, md, json, web
  fileSize    Int?      @default(0)
  content     String
  summary     String?
  tokenCount  Int       @default(0)
  status      String    @default("ready") // processing, ready, error
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Workspace {
  id                   String         @id @default(uuid())
  name                 String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  
  // Billing Fields
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  subscriptionStatus   String         @default("trialing") // trialing, active, past_due, canceled
  planTier             String         @default("Free Trial") // Starter, Growth, Advanced
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  users                User[]
  contacts             Contact[]
  tags                 Tag[]
  aiAgentConfig        AIAgentConfig?
  knowledgeDocs        KnowledgeDocument[]
  products             Product[]
  orders               Order[]
  slaConfig            SLAConfig?
  teamInvitations      TeamInvitation[]
  callLogs             CallLog[]
  ivrConfig            IVRConfig?
  coldCallCampaigns    ColdCallCampaign[]
  rcsTemplates         RcsTemplate[]
  rcsCampaigns         RcsCampaign[]
  instagramRules       InstagramRule[]
  cascadeRules         CascadeRule[]
  emailCampaigns       EmailCampaign[]
  emailTemplates       EmailTemplate[]
  emailContacts        EmailContact[]
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?   // Hashed password
  name        String
  role        String    @default("Agent") // Owner, Admin, Agent, Viewer
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Contact {
  id            String         @id @default(uuid())
  phoneNumber   String
  name          String?
  attributes    String?        @default("{}") // Storing JSON as string for SQLite
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  tags          Tag[]          @relation("ContactTags")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, phoneNumber])
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  color       String    @default("#00a688")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  contacts    Contact[] @relation("ContactTags")
  createdAt   DateTime  @default(now())
}

model Conversation {
  id          String    @id @default(uuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id])
  status      String    @default("open") // open, resolved, snoozed
  channel     String    @default("whatsapp")
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  text           String
  sender         String       // "agent", "contact", "bot"
  status         String       @default("sent") // sent, delivered, read, failed
  channel        String?      @default("whatsapp")
  mediaUrl       String?
  metadata       String?      // Storing JSON string for buttons, cards, action payload
  timestamp      DateTime     @default(now())
}

model AutoReplyRule {
  id        String   @id @default(uuid())
  keyword   String   @unique
  replyText String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String    @id @default(uuid())
  name        String
  price       Float
  stock       Int       @default(0)
  status      String    @default("Active") // Active, Out of Stock, Draft
  image       String?   @default("bg-brand-primary")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id             String    @id @default(uuid())
  orderNumber    String    @unique
  amount         Float
  currency       String    @default("USD")
  status         String    @default("Pending") // Pending, Paid, Cancelled
  customerName   String?
  customerPhone  String?
  items          String?   // JSON string of item name, quantity, description
  paymentMethod  String?   // stripe, razorpay, upi, card
  paymentUrl     String?
  paidAt         DateTime?
  conversationId String?
  contactId      String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
}

model SLAConfig {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
  firstResponseTarget String    @default("Within 15 minutes")
  resolutionTarget    String    @default("Within 2 hours")
  workingHours        String    @default("Monday - Friday, 9:00 AM - 6:00 PM")
  updatedAt           DateTime  @updatedAt
}

model TeamInvitation {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("Agent")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  token       String    @unique @default(uuid())
  status      String    @default("Pending") // Pending, Accepted, Expired
  createdAt   DateTime  @default(now())
}

model CallLog {
  id          String    @id @default(uuid())
  contactName String
  phoneNumber String
  duration    String
  sentiment   String    @default("Neutral") // Positive, Neutral, Negative, Interested
  type        String    @default("incoming") // incoming, outgoing, missed, cold_call
  transcript  String?
  summary     String?
  audioUrl    String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  timestamp   DateTime  @default(now())
}

model IVRConfig {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  welcomeMessage String    @default("Thank you for calling Ricoz. How may we assist you today?")
  aiPrompt       String    @default("You are a friendly AI receptionist for Ricoz. Answer common inquiries and transfer to support if requested.")
  voiceGender    String    @default("female")
  fallbackNumber String?
  updatedAt      DateTime  @updatedAt
}

model ColdCallCampaign {
  id             String    @id @default(uuid())
  name           String
  status         String    @default("draft") // draft, running, completed, paused
  totalLeads     Int       @default(0)
  completedLeads Int       @default(0)
  bookedDemos    Int       @default(0)
  voicePersona   String    @default("ElevenLabs - Rachel (Warm B2B)")
  scriptPrompt   String
  leadsData      String?   // JSON array of contacts to dial
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RcsTemplate {
  id          String    @id @default(uuid())
  name        String
  cardType    String    @default("standalone") // standalone, carousel
  title       String
  description String
  mediaUrl    String?
  actions     String?   // JSON string array of action chips
  status      String    @default("approved")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model RcsCampaign {
  id          String    @id @default(uuid())
  name        String
  status      String    @default("sent") // draft, sending, sent
  sentCount   Int       @default(0)
  readCount   Int       @default(0)
  clickCount  Int       @default(0)
  templateId  String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
}

model InstagramRule {
  id           String    @id @default(uuid())
  triggerType  String    @default("comment") // comment, story_mention, dm_keyword
  keyword      String
  replyComment String?
  dmResponse   String
  isActive     Boolean   @default(true)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime  @default(now())
}

model CascadeRule {
  id                 String    @id @default(uuid())
  name               String
  status             String    @default("active") // active, paused
  primaryChannel     String    @default("rcs")    // rcs, whatsapp
  primaryCondition   String    @default("undelivered_or_unread")
  secondaryChannel   String    @default("whatsapp") // whatsapp, sms
  secondaryCondition String    @default("failed")
  tertiaryChannel    String    @default("voice") // voice, email, sms
  timeoutMinutes     Int       @default(5)
  retryCount         Int       @default(2)
  messageText        String?   @default("Hi {{name}}, here is your urgent Ricoz update.")
  statsSent          Int       @default(0)
  statsPrimary       Int       @default(0)
  statsSecondary     Int       @default(0)
  statsTertiary      Int       @default(0)
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model EmailTemplate {
  id          String          @id @default(uuid())
  name        String
  subject     String
  htmlBody    String          // Full HTML email body
  previewText String?         // Shown in inbox preview
  category    String          @default("Marketing") // Marketing, Transactional, Newsletter, Promotional
  status      String          @default("draft")   // draft, published
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  campaigns   EmailCampaign[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model EmailCampaign {
  id              String         @id @default(uuid())
  name            String
  subject         String
  fromName        String         @default("Ricoz Communication")
  fromEmail       String         @default("hello@ricoz.io")
  replyTo         String?
  status          String         @default("draft")     // draft, scheduled, sending, sent, paused
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int            @default(0)
  delivered       Int            @default(0)
  opened          Int            @default(0)
  clicked         Int            @default(0)
  bounced         Int            @default(0)
  unsubscribed    Int            @default(0)
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id])
  audienceTag     String?        // Filter contacts by tag
  htmlBody        String         // Actual email HTML content
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model EmailContact {
  id          String    @id @default(uuid())
  email       String
  name        String?
  tags        String?   @default("[]")
  status      String    @default("subscribed")  // subscribed, unsubscribed, bounced, cleaned
  source      String    @default("manual")       // manual, import, whatsapp_sync, api
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, email])
}
